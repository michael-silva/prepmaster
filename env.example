# Copie para .env.local e preencha com as credenciais
# Frontend (VITE_*) e Firebase: docs/env-setup.md

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional: base URL da API (ex: https://projeto.vercel.app). Se vazio, usa relative /api
VITE_API_URL=

# API (Vercel env vars - não usar VITE_ prefix)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_WEBHOOK_URL=
GEMINI_API_KEY=
